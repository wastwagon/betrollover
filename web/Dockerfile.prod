# BetRollover Web - Production Dockerfile
# Build context: project root (.)
# NEXT_PUBLIC_* must be set at build time - pass as ARG in Coolify/docker-compose
#
# Exit 255 during `next build` on Coolify is usually OOM (often right after “Checking validity of types”):
# - Coolify often runs `docker compose build` for api+web in parallel — two Node heaps at once.
# - NEXT_BUILD_LOW_MEMORY=1 skips Next typecheck (same idea as --no-lint) so typecheck cannot OOM the step.
# - Use a builder with 6–8GB RAM, OR raise Coolify build timeout, OR deploy api/web as separate resources.
# - Default heap 1536MB: raising it alone does not help much when the api builder runs at the same time.
FROM node:20-alpine AS builder

ENV NEXT_TELEMETRY_DISABLED=1
ENV NEXT_BUILD_LOW_MEMORY=1
ARG BUILD_NODE_MAX_OLD_SPACE_SIZE=1536
ENV NODE_OPTIONS=--max-old-space-size=${BUILD_NODE_MAX_OLD_SPACE_SIZE}

# Build shared-types first (web depends on file:../packages/shared-types)
COPY packages/shared-types /packages/shared-types
WORKDIR /packages/shared-types
RUN npm ci && npm run build

# Web app (from /app; package.json has file:../packages/shared-types so /packages must be sibling of /app)
WORKDIR /app
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_APP_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL

# Inlined into the client bundle at `next build` — must be build args in Coolify/Docker (runtime env alone is not enough).
ARG NEXT_PUBLIC_GTM_ID=
ARG NEXT_PUBLIC_GA_MEASUREMENT_ID=
ARG NEXT_PUBLIC_GOOGLE_CLIENT_ID=
ARG NEXT_PUBLIC_APPLE_CLIENT_ID=
ARG NEXT_PUBLIC_SENTRY_DSN=
ARG NEXT_PUBLIC_TELEGRAM_ADS_HANDLE=
ARG NEXT_PUBLIC_SUBSCRIPTIONS_ENABLED=false
ENV NEXT_PUBLIC_GTM_ID=$NEXT_PUBLIC_GTM_ID
ENV NEXT_PUBLIC_GA_MEASUREMENT_ID=$NEXT_PUBLIC_GA_MEASUREMENT_ID
ENV NEXT_PUBLIC_GOOGLE_CLIENT_ID=$NEXT_PUBLIC_GOOGLE_CLIENT_ID
ENV NEXT_PUBLIC_APPLE_CLIENT_ID=$NEXT_PUBLIC_APPLE_CLIENT_ID
ENV NEXT_PUBLIC_SENTRY_DSN=$NEXT_PUBLIC_SENTRY_DSN
ENV NEXT_PUBLIC_TELEGRAM_ADS_HANDLE=$NEXT_PUBLIC_TELEGRAM_ADS_HANDLE
ENV NEXT_PUBLIC_SUBSCRIPTIONS_ENABLED=$NEXT_PUBLIC_SUBSCRIPTIONS_ENABLED

COPY web/package*.json ./
RUN npm ci

COPY web/ ./
# --no-lint + ignoreBuildErrors (NEXT_BUILD_LOW_MEMORY) saves memory on Coolify; typecheck locally/CI
RUN npm run build:docker

# Production stage — standalone output (no full node_modules copy).
# Coolify was failing with exit 255 while unpacking a ~GB web image after a successful `next build`.
FROM node:20-alpine AS runner

WORKDIR /app
RUN apk add --no-cache curl
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

COPY --from=builder /app/public ./public
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static

EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

CMD ["node", "server.js"]
